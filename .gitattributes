# 统一换行符，避免 Windows 上编辑后整个文件显示为改动
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.tgz binary
*.gz binary
*.sqlite3 binary
